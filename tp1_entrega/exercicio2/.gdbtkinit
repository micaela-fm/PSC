# GDBtk Init file
# GDBtkInitVersion: 1
[global]
	font/bold=-family courier -size 12 -weight bold
	font/default=-family Courier -size 12 -weight normal -slant roman -underline 0 -overstrike 0
	font/menu=-family {Nimbus Sans} -size 12 -weight normal -slant roman -underline 0 -overstrike 0
	font/status=-family {Nimbus Sans} -size 11 -weight normal -slant roman -underline 0 -overstrike 0
	font/fixed=-family Courier -size 12 -weight normal -slant roman -underline 0 -overstrike 0
	font/italic=-family courier -size 12 -slant italic
[gdb]
	font_cache=Courier {Courier 10 Pitch} Cousine {DejaVu Sans Mono} {EB Garamond Initials} {EB Garamond Initials Fill1} FreeMono {Go Mono} {Liberation Mono} MathJax_Vector MathJax_Vector-Bold {Nimbus Mono PS} {Noto Color Emoji} {Noto Mono} {Noto Sans SignWriting} {PT Mono} {Ubuntu Mono} {Ubuntu Sans Mono}
	main_names=main MAIN___ MAIN__ cyg_user_start cyg_start
	compat=default
	use_icons=1
	B1_behavior=1
	recent-projects=/home/micaela/ISEL/PSC/PSC/tp1_entrega/exercicio2/my_memmove_test
	use_color_schemes=1
	ImageDir=images2
	mode=0
	control_target=1
[load]
	main=1
	verbose=0
	baud=38400
	exit=1
	port=/dev/ttyS0
	check=0
	bp_at_func=0
[console]
	wrap=1
	prompt=(gdb) 
	prompt_fg=DarkGreen
	log_fg=#00b300
	font=global/fixed
	target_fg=blue
	error_fg=red
	deleteLeft=1
[src]
